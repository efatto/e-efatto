<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sorp_view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_unlock" position="after">
                <button name="recalculate_bom_costs" class="ml-2 btn btn-default"
                        string="Recalculate bom costs"
                        Help="Update only cost of produced products"
                        type="object"
                        groups="sale_margin_security.group_sale_margin_security"/>
            </button>
        </field>
    </record>

</odoo>
