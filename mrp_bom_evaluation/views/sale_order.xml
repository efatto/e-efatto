<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.mrp.evaluation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_unlock" position="after">
                <button name="recalculate_all_costs" class="ml-2 btn btn-default"
                        string="Recalculate all costs"
                        Help="Update cost of produced products"
                        type="object"
                        groups="sale_margin_security.group_sale_margin_security"/>
            </button>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="extra_cost" groups="base.group_system"/>
                <field name="internal_timesheet_cost" groups="base.group_system"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                <field name="estimated_purchase_price" groups="base.group_user"/>
                <field name="final_purchase_price" groups="base.group_user"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="estimated_purchase_price" groups="base.group_user"/>
                <field name="final_purchase_price" groups="base.group_user"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                <field name="lead_line_id" groups="base.group_system"/>
                <field name="mrp_production_ids" widget="many2many_tags" groups="base.group_system"/>
                <field name="workorder_price_subtotal" groups="base.group_system"/>
                <field name="move_raw_price_subtotal" groups="base.group_system"/>
                <field name="mrp_production_total_amount" groups="base.group_system"/>
                <field name="analytic_cost" groups="base.group_system"/>
                <field name="total_cost" groups="base.group_system"/>
            </xpath>
        </field>
    </record>

</odoo>
