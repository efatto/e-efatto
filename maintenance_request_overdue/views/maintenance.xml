<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_equipment_request_view_search" model="ir.ui.view">
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search" />
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <filter name="activities_overdue" position="after">
                <filter
          string="Overdue Maintenance Requests"
          name="maintenance_requests_overdue"
          domain="[
              ('schedule_date', '&lt;', context_today().strftime('%Y-%m-%d')),
              ('stage_id.done', '=', False),
          ]"
          help="Show all records which has scheduled date before today"
        />
            </filter>
        </field>
    </record>

</odoo>
