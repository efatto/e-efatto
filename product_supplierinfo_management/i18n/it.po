#. module: product_supplierinfo_management
#: model_terms:ir.ui.view,arch_db:product_supplierinfo_management.product_pricelist_item_form_view
msgid ""
"<span class=\"oe_grey\" attrs=\"{'invisible': [('enable_supplierinfo_management', '=', False)]}\">\n"
"                    The base price in this pricelist is not visible as it is used the cost price found in purchase, invoice, seller or product by default. So you only have to set the formula or discount (or fixed price by product) to apply to these automatically selected costs.\n"
"                </span>"
msgstr ""
"<span class=\"oe_grey\" attrs=\"{'invisible': [('enable_supplierinfo_management', '=', False)]}\">\n"
"                    Il prezzo di base in questo listino prezzi non è visibile perché viene usato il prezzo di costo trovato in acquisti, fatture, fornitore o nel prodotto per default. Perciò è solo necessario impostare la formula o lo sconto (o il prezzo fisso per prodotto) da applicare a questi costi selezionati automaticamente.\n"
"                </span>"

