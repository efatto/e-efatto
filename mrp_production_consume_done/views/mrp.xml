<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='move_raw_ids']/tree/field[@name='product_id']"
        position="after"
      >
                <field name="price_unit" invisible="1" />
            </xpath>
            <xpath
        expr="//field[@name='move_raw_ids']/tree/field[@name='quantity_done']"
        position="attributes"
      >
                <attribute
          name="attrs"
        >{'readonly': [('is_locked', '=', True)]}</attribute>
            </xpath>
            <xpath
        expr="//page[@name='operations']/field[@name='workorder_ids']"
        position="attributes"
      >
                <attribute
          name="attrs"
        >{'readonly': [('state', 'in', ['cancel', 'done']), ('is_locked', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
