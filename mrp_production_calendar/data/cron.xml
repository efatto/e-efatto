<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="ir_cron_mrp_production_calendar" model="ir.cron">
        <field name="name">Production Calendar - update to be replanned workorders</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
        <field name="model_id" ref="model_mrp_workcenter" />
        <field name="state">code</field>
        <field name="code">model._cron_compute_to_be_replanned()</field>
        <field name="doall" eval="False" />
    </record>

</odoo>
