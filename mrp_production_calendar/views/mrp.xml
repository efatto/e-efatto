<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_routing_workcenter_form_view" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view" />
        <field name="arch" type="xml">
            <field name="workcenter_id" position="before">
                <field name="parallel_execution" widget="boolean_toggle" />
                <field
          name="optional_parallel_workcenter_ids"
          widget="many2many_tags"
        />
            </field>
        </field>
    </record>

    <record id="mrp_routing_workcenter_tree_view" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.tree</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view" />
        <field name="arch" type="xml">
            <field name="workcenter_id" position="before">
                <field name="parallel_execution" widget="boolean_toggle" />
                <field
          name="optional_parallel_workcenter_ids"
          widget="many2many_tags"
        />
            </field>
        </field>
    </record>

    <record id="mrp_production_workorder_tree_editable_view" model="ir.ui.view">
        <field name="name">mrp.production.work.order.tree</field>
        <field name="model">mrp.workorder</field>
        <field
      name="inherit_id"
      ref="mrp.mrp_production_workorder_tree_editable_view"
    />
        <field name="arch" type="xml">
            <field name="workcenter_id" position="after">
                <field name="parallel_execution" widget="boolean_toggle" optional="hide" />
                <field name="parallel_qty_production" optional="hide" />
            </field>
        </field>
    </record>

    <record id="workcenter_line_calendar" model="ir.ui.view">
        <field name="name">mrp.production.work.order.calendar</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_calendar" />
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="event_limit">0</attribute>
            </xpath>
            <field name="workcenter_id" position="after">
                <field name="name" />
                <field name="origin" />
            </field>
        </field>
    </record>

    <record id="mrp_workorder_timeline" model="ir.ui.view">
        <field name="model">mrp.workorder</field>
        <field name="type">timeline</field>
        <field name="arch" type="xml">
            <timeline
        date_start="date_planned_start"
        date_stop="date_planned_finished"
        default_group_by="workcenter_id"
        event_open_popup="true"
        mode="week"
        dependency_arrow="previous_work_order_ids"
      />
        </field>
    </record>

    <record id="mrp.mrp_workorder_todo" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,timeline,calendar,pivot,graph</field>
    </record>

    <record model="ir.actions.act_window" id="mrp.action_work_orders">
        <field name="view_mode">tree,timeline,form,gantt,pivot,graph,calendar</field>
    </record>

    <record
    id="mrp.action_mrp_workorder_production_specific"
    model="ir.actions.act_window"
  >
        <field name="view_mode">tree,form,gantt,timeline,calendar,pivot,graph</field>
    </record>

    <record id="mrp_production_kanban_view" model="ir.ui.view">
        <field name="name">mrp.production.kanban</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">state</attribute>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="date_planned_finished_computed" />
            </field>
        </field>
    </record>

    <record id="view_production_calendar" model="ir.ui.view">
        <field name="name">mrp.production.calendar</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_production_calendar" />
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="color">name</attribute>
                <attribute name="mode">month</attribute>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_timeline" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="type">timeline</field>
        <field name="arch" type="xml">
            <timeline
        date_start="date_planned_start"
        date_stop="date_planned_finished_computed"
        default_group_by="user_id"
        event_open_popup="true"
        mode="month"
        dependency_arrow="previous_production_ids"
      />
        </field>
    </record>

    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,timeline,calendar,pivot,graph</field>
    </record>

    <record id="workcenter_line_kanban" model="ir.ui.view">
        <field name="name">mrp.workorder.kanban</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">state</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_work_order_search" model="ir.ui.view">
        <field name="name">mrp.production.work.order.search</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_work_order_search" />
        <field name="arch" type="xml">
            <filter name="late" position="after">
                <filter
          string="To Be Replanned"
          name="to_be_replanned"
          domain="[('to_be_replanned', '=', True)]"
        />
            </filter>
        </field>
    </record>

    <record id="mrp_workcenter_kanban" model="ir.ui.view">
        <field name="name">mrp.workcenter.kanban</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_kanban" />
        <field name="arch" type="xml">
            <field name="oee_target" position="after">
                <field name="wo_to_be_replanned_count" />
            </field>
            <div name="plan_order" position="after">
                <div role="menuitem" name="check_orders_to_be_replanned">
                    <a
            name="action_compute_to_be_replanned"
            type="object"
          >Check To Replan Orders</a>
                </div>
            </div>
            <xpath
        expr="//div[hasclass('col-6', 'o_kanban_primary_right')]"
        position="inside"
      >
                <div
          class="row"
          t-if="record.wo_to_be_replanned_count.raw_value &gt; 0"
        >
                    <div class="col-8">
                        <a
              name="action_work_order"
              type="object"
              context="{'search_default_to_be_replanned': 1}"
            >
                            To Be Replanned
                        </a>
                    </div>
                    <div class="col-4 text-right">
                        <field name="wo_to_be_replanned_count" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>


    <menuitem
    id="menu_mrp_workcenter_dashboard"
    name="MRP Overview"
    action="mrp.mrp_workcenter_kanban_action"
    groups="mrp.group_mrp_routings"
    parent="mrp.menu_mrp_root"
    sequence="5"
  />

</odoo>
