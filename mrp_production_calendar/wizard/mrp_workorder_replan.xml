<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_workorder_replan" model="ir.ui.view">
        <field name="name">mrp.workorder.replan.wizard</field>
        <field name="model">mrp.workorder.replan</field>
        <field name="arch" type="xml">
            <form string="Replan workorders">
                <div>
                    Are you sure you want to replan all selected workorders?
                </div>
                <footer>
                    <button
            name="action_done"
            string="Confirm"
            type="object"
            class="btn-primary"
          />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_replan_workorder">
        <field name="name">Replan workorder</field>
        <field name="res_model">mrp.workorder.replan</field>
        <field name="view_mode">form</field>
        <field
            name="binding_model_id"
            ref="mrp.model_mrp_workorder"
        />
        <field name="target">new</field>
    </record>

</odoo>
