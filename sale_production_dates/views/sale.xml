<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="mrp_date_finished" />
            </field>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='tax_id']"
                position="after"
            >
                <field name="mrp_date_finished" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='tax_id']"
                position="before"
            >
                <field name="mrp_production_ids" invisible="1" />
                <field name="mrp_date_finished" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
