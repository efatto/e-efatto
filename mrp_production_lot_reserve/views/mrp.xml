<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <label for="lot_producing_id" position="before">
                <field
          name="reserved_lot_ids"
          widget="many2many_tags"
          options="{'no_create_edit': True, 'no_quick_create': True}"
          attrs="{'invisible': [('product_tracking', 'in', ('none', False))]}"
          domain="[('product_id', '=', product_id), ('is_reserved_or_used', '=', False)]"
        />
            </label>
            <field name="lot_producing_id" position="attributes">
                <attribute name="domain">
                   ['&amp;',
                    ('product_id', '=', product_id),
                    '|',
                    ('id', 'in', reserved_lot_ids),
                    '&amp;',
                    ('id', 'not in', reserved_lot_ids),
                    ('is_reserved_or_used', '=', False)
                    ]
                </attribute>
            </field>
            <button name="action_generate_serial" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
        </field>
    </record>

</odoo>
