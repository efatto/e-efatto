<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_production_filter" model="ir.ui.view">
        <field name="name">mrp.production.select.consumed</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="arch" type="xml">
            <filter name="todo" position="attributes">
                <attribute
          name="domain"
        >[('state', 'in', ('draft', 'consumed', 'confirmed', 'progress', 'to_close'))]</attribute>
            </filter>
        </field>
    </record>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <button name="%(mrp.action_mrp_production_moves)d" position="attributes">
                <attribute
          name="invisible"
        >state not in ('consumed', 'progress', 'done')</attribute>
            </button>
            <button name="button_mark_done" position="before">
                <field name="sent_to_whs" invisible="1" />
                <field name="bom_type" invisible="1" />
                <field name="is_consumable" invisible="1" />
                <field name="hide_mark_done" invisible="1" />
                <button
          name="button_send_to_whs"
          type="object"
          string="Send to WHS"
          class="oe_highlight"
          invisible="bom_type == 'subcontract' or state != 'progress' or sent_to_whs"
        />
            </button>
            <xpath expr="//button[@name='button_mark_done']" position="before">
                <button
          name="button_consume"
          type="object"
          class="oe_highlight"
          string="Consume components"
          invisible="bom_type == 'subcontract' or not is_consumable or state != 'progress' or not qty_producing or not sent_to_whs"
        />
                <button
          name="button_consume"
          type="object"
          string="Consume components"
          invisible="bom_type == 'subcontract' or not is_consumable or state != 'consumed' or not qty_producing"
        />
            </xpath>
            <xpath
        expr="/form/header/button[@name='button_mark_done'][1]"
        position="attributes"
      >
                <attribute name="string">Produce</attribute>
                <attribute name="invisible">
                    (
                        state not in ['progress', 'consumed']
                        or not qty_producing
                    ) if bom_type == 'subcontract' else (
                        is_consumable
                        or state not in ['progress', 'consumed']
                        or not qty_producing
                        or not sent_to_whs
                    )
                </attribute>
            </xpath>
            <xpath
        expr="/form/header/button[@name='button_mark_done'][2]"
        position="attributes"
      >
                <attribute name="invisible">True</attribute>
            </xpath>
            <field name="qty_producing" position="attributes">
                <attribute
          name="readonly"
        >qty_producing or sent_to_whs or state not in ['draft', 'confirmed', 'progress']</attribute>
            </field>
        </field>
    </record>
</odoo>
