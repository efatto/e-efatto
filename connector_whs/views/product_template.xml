<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchase_ok']/ancestor::*[1]" position="after">
                <div>
                    <field name="exclude_from_whs" />
                    <label for="exclude_from_whs" />
                </div>
                <button
          name="show_whs_syncronization_records"
          type="object"
          string="Get WMS syncronizing data"
          invisible="exclude_from_whs"
        />
            </xpath>
        </field>
    </record>

</odoo>
