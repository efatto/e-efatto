<?xml version="1.0"?>
<odoo>

    <record id="view_move_picking_form" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_picking_form"/>
        <field name="arch" type="xml">
            <field name="move_dest_ids" position="after">
                <field name="whs_list_ids"/>
            </field>
        </field>
    </record>
    <record id="view_stock_move_operations" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations" />
        <field name="arch" type="xml">
            <field name="move_line_ids" position="after">
                <field name="whs_list_ids"/>
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <button name="button_validate" position="after">
                <button name="button_validate_bypass_wms"
                        attrs="{'invisible': ['|', ('state', 'in', ('waiting','confirmed')), ('show_validate', '=', False)]}"
                        string="Validate Bypassing WMS"
                        type="object"
                        class="oe_highlight"
                        groups="stock.group_stock_user"/>
                <button name="button_validate_bypass_wms"
                        attrs="{'invisible': ['|', ('state', 'not in', ('waiting', 'confirmed')), ('show_validate', '=', False)]}"
                        string="Validate Bypassing WMS"
                        type="object"
                        groups="stock.group_stock_user"
                        class="o_btn_validate"/>
            </button>
        </field>
    </record>

</odoo>
