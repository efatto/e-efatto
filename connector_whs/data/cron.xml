<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="ir_cron_connector_whs_insert_list" model="ir.cron">
        <field name="name">Connector WMS - synchronize</field>
        <field name="interval_number">3</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
        <field name="model_id" ref="model_base_external_dbsource" />
        <field name="state">code</field>
        <field name="code">model._cron_whs_synchronize()</field>
        <field name="doall" eval="False" />
    </record>

    <record id="ir_cron_connector_whs_sync_stock" model="ir.cron">
        <field
            name="name"
        >Connector WMS - synchronize stock (pass True to do inventory sync, else it will create only WMS log)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False" />
        <field name="model_id" ref="model_base_external_dbsource" />
        <field name="state">code</field>
        <field name="code">model._cron_whs_synchronize_stock(True)</field>
        <field name="doall" eval="False" />
    </record>

    <record id="ir_cron_connector_whs_clean_lists" model="ir.cron">
        <field
            name="name"
        >Connector WMS - remove old lists from Odoo and from WHS</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False" />
        <field name="model_id" ref="model_base_external_dbsource" />
        <field name="state">code</field>
        <field name="code">model._cron_whs_clean_lists()</field>
        <field name="doall" eval="False" />
    </record>

    <record id="ir_cron_connector_whs_sync_product_info" model="ir.cron">
        <field name="name">Connector WMS - synchronize all product info</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False" />
        <field name="model_id" ref="model_base_external_dbsource" />
        <field name="state">code</field>
        <field name="code">model._cron_whs_update_products("2000-01-01")</field>
        <field name="doall" eval="False" />
    </record>

</odoo>
