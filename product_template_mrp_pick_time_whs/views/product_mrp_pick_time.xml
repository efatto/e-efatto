<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_mrp_pick_time_search" model="ir.ui.view">
        <field name="name">product.mrp.pick.time.search</field>
        <field name="model">product.mrp.pick.time</field>
        <field
      name="inherit_id"
      ref="product_template_mrp_pick_time.view_product_mrp_pick_time_search"
    />
        <field name="arch" type="xml">
            <field name="duration" position="after">
                <field name="duration_whs" />
            </field>
        </field>
    </record>
    <record id="view_product_mrp_pick_time_tree" model="ir.ui.view">
        <field name="name">product.mrp.pick.time.tree</field>
        <field name="model">product.mrp.pick.time</field>
        <field
      name="inherit_id"
      ref="product_template_mrp_pick_time.view_product_mrp_pick_time_tree"
    />
        <field name="arch" type="xml">
            <field name="duration" position="after">
                <field name="duration_whs" widget="float_time" />
            </field>
        </field>
    </record>
    <record id="view_product_mrp_pick_time_form" model="ir.ui.view">
        <field name="name">product.mrp.pick.time.form</field>
        <field name="model">product.mrp.pick.time</field>
        <field
      name="inherit_id"
      ref="product_template_mrp_pick_time.view_product_mrp_pick_time_form"
    />
        <field name="arch" type="xml">
            <field name="duration" position="after">
                <field name="duration_whs" widget="float_time" />
            </field>
        </field>
    </record>

</odoo>
