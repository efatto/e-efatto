<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_production_set_search" model="ir.ui.view">
        <field name="name">mrp.production.set.search</field>
        <field name="model">mrp.production.set</field>
        <field name="arch" type="xml">
            <search string="Production Set">
                <field name="name" />
                <field name="production_left_id" />
                <field name="production_right_id" />
            </search>
        </field>
    </record>

    <record id="mrp_production_set_tree" model="ir.ui.view">
        <field name="name">mrp.production.set.tree</field>
        <field name="model">mrp.production.set</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="create_date" />
                <field name="production_left_id" />
                <field name="production_right_id" />
            </tree>
        </field>
    </record>

    <record id="mrp_production_set_form" model="ir.ui.view">
        <field name="name">mrp.production.set.form</field>
        <field name="model">mrp.production.set</field>
        <field name="arch" type="xml">
            <form string="Production Set">
                <header>
                    <button
            name="action_confirm"
            type="object"
            string="Confirm"
            class="oe_highlight"
            attrs="{'invisible': [('state', '!=', 'draft')]}"
          />
                    <button
            name="button_plan"
            type="object"
            string="Plan workorders"
            class="oe_highlight"
            attrs="{'invisible': [('state', '!=', 'confirmed')]}"
          />
                    <button
            name="button_update_qty_producing"
            type="object"
            string="Update qty producing"
            class="oe_highlight"
            attrs="{'invisible': ['|', '|', ('state', '!=', 'confirmed'), ('production_left_id', '=', False), ('production_right_id', '=', False)]}"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="draft,confirmed,progress,done"
          />
                </header>
                <sheet string="Production Set">
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1><field name="name" /></h1>
                    </div>
                    <field name="compatible_mrp_production_ids" invisible="1" />
                    <group>
                        <group>
                            <field name="move_raw_product_id" readonly="1" />
                            <field name="split_production" />
                        </group>
                        <group>
                            <field name="create_date" />
                        </group>
                    </group>
                    <group>
                        <group string="Production Left">
                            <field name="production_left_id" />
                            <field name="qty_producing_left" />
                        </group>
                        <group string="Production Right">
                            <div
                attrs="{'invisible': [('split_production', '!=', True)]}"
                style="font-weight: bold;"
              >
                                The same as Production Left
                            </div>
                            <field
                name="production_right_id"
                domain="[('id', 'in', compatible_mrp_production_ids)] "
                attrs="{'invisible': [('split_production', '=', True)]}"
              />
                            <field name="qty_producing_right" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_production_set" model="ir.actions.act_window">
        <field name="name">Production Sets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.production.set</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
    action="action_mrp_production_set"
    id="menu_mrp_production_set"
    parent="mrp.menu_mrp_manufacturing"
    sequence="2"
  />

</odoo>
