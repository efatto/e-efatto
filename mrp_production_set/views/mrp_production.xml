<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="has_production_set" invisible="1" />
                <field
          name="production_left_set_ids"
          widget="many2many_tags"
          attrs="{'invisible': True}"
        />
                <field
          name="production_right_set_ids"
          widget="many2many_tags"
          attrs="{'invisible': True}"
        />
                <label
          for="has_production_set"
          string=""
          attrs="{'invisible': [('has_production_set', '=', False)]}"
        />
                <div
          class="alert alert-info"
          role="alert"
          style="margin-bottom:0px;"
          attrs="{'invisible': [('has_production_set', '=', False)]}"
        >
                    This production is part of a Production SET
                </div>
            </xpath>
        </field>
    </record>
</odoo>
