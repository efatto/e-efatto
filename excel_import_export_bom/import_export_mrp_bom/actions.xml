<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_mrp_bom_export_xlsx" model="ir.actions.act_window">
        <field name="name">Export Excel</field>
        <field name="res_model">export.xlsx.wizard</field>
        <field name="view_mode">form</field>
      <field name="binding_model_id" ref="mrp.model_mrp_bom" />
        <field name="target">new</field>
        <field name="context">{
            'template_domain': [('res_model', '=', 'mrp.bom'),
                                ('fname', '=', 'mrp_bom.xlsx'),
                                ('gname', '=', False)], }
        </field>
    </record>

    <record id="action_mrp_production_bom_export_xlsx" model="ir.actions.act_window">
        <field name="name">Export Bom Excel</field>
        <field name="res_model">export.xlsx.wizard</field>
        <field name="view_mode">form</field>
      <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="target">new</field>
        <field name="context">{
            'template_domain': [('res_model', '=', 'mrp.production'),
                                ('fname', '=', 'mrp_production_bom.xlsx'),
                                ('gname', '=', False)], }
        </field>
    </record>

    <record id="action_mrp_bom_import_xlsx" model="ir.actions.act_window">
        <field name="name">Import Excel</field>
        <field name="res_model">import.xlsx.wizard</field>
        <field name="view_mode">form</field>
      <field name="binding_model_id" ref="mrp.model_mrp_bom" />
        <field name="target">new</field>
        <field name="context">{
            'template_domain': [('res_model', '=', 'mrp.bom'),
                                ('fname', '=', 'mrp_bom.xlsx'),
                                ('gname', '=', False)],
            'template_context': {},
            'template_import_states': [], }
        </field>
    </record>

</odoo>
