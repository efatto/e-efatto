<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="change_production_component" model="ir.ui.view">
        <field name="name">mrp.production.component.change</field>
        <field name="model">mrp.production.component.change</field>
        <field name="arch" type="xml">
            <form string="Change component">
                <div>
                    <group>
                        <field name="product_id" />
                        <field name="product_uom_qty" />
                    </group>
                </div>
                <div>
                    Are you sure you want to change this component or this quantity?
                </div>
                <footer>
                    <button string="Discard" special="cancel" class="btn-secondary" />
                    <button
            name="action_done"
            string="Confirm"
            type="object"
            class="btn-primary"
          />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_change_production_component" model="ir.actions.act_window">
        <field name="name">Change production component</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.production.component.change</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
