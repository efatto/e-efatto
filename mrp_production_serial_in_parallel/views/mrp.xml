<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <h1 invisible="not is_parallel_production">
                    (Production for serial in parallel)
                </h1>
            </xpath>
            <field name="product_id" position="after">
                <field name="is_parallel_production" invisible="1" />
                <field
                    name="parallel_production_id"
                    invisible="not parallel_production_id"
                />
            </field>
            <xpath expr="//field[@name='qty_producing']/.." position="attributes">
                <attribute
                    name="invisible"
                >(is_parallel_production or state == 'draft')</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_producing_id']/.." position="attributes">
                <attribute
                    name="invisible"
                >((product_tracking in ('none', False) or is_parallel_production) or state == 'draft')</attribute>
            </xpath>
            <xpath expr="//label[@for='lot_producing_id']" position="attributes">
                <attribute
                    name="invisible"
                >((product_tracking in ('none', False) or is_parallel_production) or state == 'draft')</attribute>
            </xpath>
            <xpath
                expr="/form/header/button[@name='button_mark_done']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >(((is_parallel_production or state not in ('confirmed', 'progress')) or qty_producing != 0) and state != 'to_close')</attribute>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_form_view_reserve" model="ir.ui.view">
        <field name="name">mrp.production.form.reserve</field>
        <field name="model">mrp.production</field>
        <field
            name="inherit_id"
            ref="mrp_production_lot_reserve.mrp_production_form_view"
        />
        <field name="arch" type="xml">
            <field name="reserved_lot_ids" position="attributes">
                <attribute
                    name="readonly"
                >not is_parallel_production and state not in ['draft', 'confirmed', 'progress']</attribute>
                <attribute
                    name="invisible"
                >product_tracking in ('none', False)</attribute>
            </field>
        </field>
    </record>
</odoo>
