<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="wizard_mrp_bom_attachment_export" model="ir.ui.view">
        <field name="name">Export components attachment</field>
        <field name="model">wizard.mrp.bom.attachment.export</field>
        <field name="arch" type="xml">
            <form string="Download ZIP components attachment">
                <group>
                    <field name="and_attachment_ctg_ids" widget="many2many_tags" />
                    <field name="or_attachment_ctg_ids" widget="many2many_tags" />
                    <field name="name" />
                </group>
                <footer>
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                    <button
            name="export_zip"
            string="Export Zip"
            type="object"
            class="btn-primary"
          />
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_production_attachment_export">
        <field name="name">Download ZIP components attachment</field>
        <field name="res_model">wizard.mrp.bom.attachment.export</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="target">new</field>
    </record>
    <record model="ir.actions.act_window" id="action_bom_attachment_export">
        <field name="name">Download ZIP components attachment</field>
        <field name="res_model">wizard.mrp.bom.attachment.export</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom" />
        <field name="target">new</field>
    </record>

</odoo>
