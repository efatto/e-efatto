<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_set_form" model="ir.ui.view">
        <field name="name">mrp.production.set.form</field>
        <field name="model">mrp.production.set</field>
        <field name="inherit_id" ref="mrp_production_set.mrp_production_set_form" />
        <field name="arch" type="xml">
            <button name="button_update_qty_producing" position="after">
                <field name="sent_to_whs" invisible="1" />
                <field name="is_planned" invisible="1" />
                <button
          name="button_send_to_whs"
          type="object"
          string="Send to WHS"
          class="oe_highlight"
          attrs="{'invisible': ['|', '|', ('state', '!=', 'progress'), ('sent_to_whs', '=', True), ('is_planned', '=', False)]}"
        />
            </button>
        </field>
    </record>
</odoo>
