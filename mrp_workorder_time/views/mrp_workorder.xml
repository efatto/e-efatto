<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_production_workorder_form_view_inherit">
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_ids']" position="attributes">
                <attribute name="invisible">state == 'ready'</attribute>
            </xpath>
            <xpath expr="//field[@name='time_ids']/list" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>
            <xpath
                expr="//field[@name='time_ids']/list/field[@name='workcenter_id']"
                position="attributes"
            >
                <attribute name="invisible">False</attribute>
            </xpath>
            <xpath
                expr="//field[@name='time_ids']/list/field[@name='date_start']"
                position="after"
            >
                <field name="unit_amount" />
            </xpath>
        </field>
    </record>
</odoo>
